{
  "name": "omp-auto-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent model review for oh-my-pi tool calls",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "omp": { "extensions": ["./src/index.ts"] },
